{
  "name": "dsh-stream-focus",
  "version": "0.1.0",
  "description": "DSH plugin: smooths running-turn thinking and tool output across all Work details modes, with a capped following window in Compact/Standard and row-level pacing in Detailed/Verbose.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && tsdown",
    "clean": "rm -rf lib",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run build && npm run test",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-chat": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../deepseek-harness/packages/client/ui-settings",
    "@types/node": "^22.10.0",
    "jsdom": "^29.0.0",
    "lightningcss": "^1.29.0",
    "tsdown": "0.22.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@deepseek-ai/dsh-client-store": "link:../../deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../deepseek-harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness/packages/client/ui-slots",
    "@types/react": "^18.3.0",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timho1047/dsh-stream-focus.git"
  },
  "bugs": {
    "url": "https://github.com/timho1047/dsh-stream-focus/issues"
  },
  "homepage": "https://timho1047.github.io/dsh-stream-focus/",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "streaming",
    "transcript",
    "reasoning",
    "tools",
    "work-details"
  ],
  "publishConfig": {
    "access": "public"
  }
}
