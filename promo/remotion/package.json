{
  "name": "dsh-stream-focus-promo",
  "version": "1.0.0",
  "description": "Remotion source for the dsh-stream-focus promo film and Bilibili cover",
  "repository": {},
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "sync-assets": "node scripts/sync-demo.mjs",
    "render:full": "npm run sync-assets && remotion render PromoFull out/dsh-stream-focus-promo.mp4 --codec=h264 --audio-codec=aac --crf=18",
    "still:cover": "remotion still BilibiliCoverSmall out/bilibili-cover.png --frame=0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
